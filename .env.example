# ---------------------------------------------------------------------------
# Plantilla de configuracion de entorno.
#
# USO:
#   cp .env.example .env
#
# El backend carga automaticamente el archivo .env al arrancar
# (spring.config.import en application.properties), tanto si esta en la raiz del
# repositorio como si esta en backend/. No hace falta exportar variables a mano.
#
# NUNCA confirme el archivo .env: ya esta en .gitignore.
# ---------------------------------------------------------------------------


# ===========================================================================
# GLPI - obligatorias para habilitar la integracion
# ===========================================================================

# URL base del API REST de GLPI.
# IMPORTANTE: debe incluir el sufijo /apirest.php
#
#   Correcto:   https://glpi.midominio.com/apirest.php
#   Incorrecto: https://glpi.midominio.com
#
# Si se deja vacia, el backend arranca igual y GET /api/glpi/health lo reporta
# como "no configurado".
GLPI_URL=

# App-Token de la aplicacion cliente.
# Se genera en GLPI > Configuracion > API > Aplicaciones cliente.
# Solo se muestra una vez al crearlo.
GLPI_APP_TOKEN=

# User-Token del usuario de integracion.
# Se genera en GLPI > Administracion > Usuarios > <usuario> > pestaña API.
# Se recomienda un usuario dedicado, con permisos de solo lectura sobre los
# ítems que se vayan a consultar.
GLPI_USER_TOKEN=


# ===========================================================================
# PostgreSQL - obligatorias para que el backend arranque
# ===========================================================================

# A diferencia de GLPI, la base de datos no es opcional: sin ella no hay donde
# guardar el plan ni el registro de idempotencia, asi que el backend no arranca.
#
# Los valores por defecto coinciden con los del servicio postgres de
# docker-compose.yml, de modo que para desarrollo local basta con:
#
#   docker compose up -d postgres
#
# y no hace falta descomentar nada aqui.
#
# DB_NAME=gestiondemanda
# DB_USER=gestiondemanda
# DB_PASSWORD=gestiondemanda

# Cadena de conexion completa. Solo hace falta si la base de datos no esta en el
# mismo equipo, o si el puerto no es el de por defecto.
# DB_URL=jdbc:postgresql://localhost:5432/gestiondemanda


# ===========================================================================
# Opcionales
# ===========================================================================

# Tiempo maximo de espera por peticion a GLPI. Formato de duracion de Spring.
# Se aplica tanto al timeout de conexion como al de respuesta.
# GLPI_TIMEOUT=5s

# Puerto HTTP del backend.
# SERVER_PORT=8080

# Perfil de Spring activo. "prod" activa los logs estructurados en formato ECS.
# SPRING_PROFILES_ACTIVE=prod

# --- Reglas de planificacion ------------------------------------------------

# Dedicacion, en horas, a partir de la cual un incidente obliga a recalcular el
# plan del desarrollador afectado. Se supera en sentido estricto: exactamente el
# umbral (4 h) no dispara replanificacion.
# Solo gobierna a los incidentes SIN severidad (dato legado): los que declaran
# severidad se rigen por su politica. Queda sin efecto cuando GLPI envie prioridad.
# PLANNING_INCIDENT_THRESHOLD_HOURS=4

# Jornada estandar de un desarrollador, en horas.
# Es la duracion del bloque de calendario cuando no se declara
# PLANNING_CALENDAR_END_TIME; si se declara, manda el bloque.
# PLANNING_WORKING_HOURS_PER_DAY=8

# Cuantos dias hacia adelante se busca hueco para un requerimiento desplazado
# antes de declararlo sin capacidad (conflicto).
# PLANNING_HORIZON_DAYS=10

# --- Calendario laboral -----------------------------------------------------

# Cuando hay alguien trabajando. De aqui sale la capacidad de cada fecha y el
# vencimiento de las OLA: sabados, domingos y festivos no consumen tiempo habil.
# PLANNING_CALENDAR_START_TIME=09:00
# PLANNING_CALENDAR_END_TIME=17:00
# PLANNING_CALENDAR_WEEKEND=SATURDAY,SUNDAY
# Festivos en formato ISO, separados por coma.
# PLANNING_CALENDAR_HOLIDAYS=2026-01-01,2026-04-02,2026-05-01,2026-12-25

# --- Acuerdo de nivel operativo (OLA) por severidad -------------------------

# Objetivos de adquisicion y resolucion de cada severidad. El comportamiento de
# planificacion (INMEDIATA, POR_CAPACIDAD, POR_SATURACION) se declara en
# application.properties, no aqui: no es un numero que se ajuste por entorno.
# PLANNING_INCIDENT_POLICIES se puede sobrescribir entera con SPRING_APPLICATION_JSON.

# OLA_ALTO_ADQUISICION_MINUTOS=15
# OLA_ALTO_RESOLUCION_HORAS=4
# OLA_MEDIO_ADQUISICION_MINUTOS=15
# OLA_MEDIO_RESOLUCION_HORAS=8
# OLA_BAJO_ADQUISICION_MINUTOS=15
# OLA_BAJO_RESOLUCION_HORAS=12


# ===========================================================================
# Frontend (van en frontend/.env.local, NO en este archivo)
# ===========================================================================

# URL base del backend.
# Vacío (por defecto) = rutas relativas, resueltas por el proxy de desarrollo de
# Vite y, en produccion, por el reverse proxy.
# VITE_API_BASE_URL=

# Destino del proxy de desarrollo. Por defecto http://localhost:8080.
# VITE_PROXY_TARGET=http://localhost:8080
